[Unit]
Description=Plant IoT FastAPI Server
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/plant-iot
Environment="PATH=/home/pi/plant-iot/.venv/bin"
ExecStart=/home/pi/plant-iot/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
