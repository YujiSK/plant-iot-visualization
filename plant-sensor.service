[Unit]
Description=Plant IoT DHT11 and ADC Sensor Sender
After=network.target plant-api.service
Requires=plant-api.service

[Service]
User=pi
WorkingDirectory=/home/pi/plant-iot
EnvironmentFile=/home/pi/plant-iot/.env
Environment="PATH=/home/pi/plant-iot/.venv/bin"
ExecStart=/home/pi/plant-iot/.venv/bin/python /home/pi/plant-iot/send_sensor.py
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
