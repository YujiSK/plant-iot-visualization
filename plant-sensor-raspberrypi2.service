[Unit]
Description=Plant IoT secondary Raspberry Pi sensor sender
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/plant-iot
EnvironmentFile=/home/pi/plant-iot/.env
Environment="PATH=/home/pi/plant-iot/.venv/bin"
ExecStart=/home/pi/plant-iot/.venv/bin/python /home/pi/plant-iot/send_sensor_raspberrypi2.py
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

