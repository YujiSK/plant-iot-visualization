digraph PlantIoTTwoDevices {
  graph [
    rankdir=LR,
    splines=line,
    nodesep=0.55,
    ranksep=1.0,
    pad=0.3,
    bgcolor="white",
    fontname="Noto Sans CJK JP",
    label="Plant IoT 2台構成配線図",
    labelloc=t,
    fontsize=20
  ];
  node [shape=plain, fontname="Noto Sans CJK JP", fontsize=10];
  edge [fontname="Noto Sans CJK JP", fontsize=9, color="#334155", dir=none];

  raspi_sensors [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#0284c7">
      <TR><TD COLSPAN="2" BGCOLOR="#e0f2fe"><B>raspi / 設置場所A</B></TD></TR>
      <TR><TD PORT="dht">DHT11 DATA</TD><TD>GPIO17 / 物理11</TD></TR>
      <TR><TD PORT="ds">DS18B20 DATA</TD><TD>GPIO4 / 物理7 + 4.7kΩ</TD></TR>
      <TR><TD PORT="water">水位 SIG</TD><TD>ADC CH0</TD></TR>
      <TR><TD PORT="cds">CdS AO</TD><TD>ADC CH1</TD></TR>
      <TR><TD PORT="led">LED</TD><TD>GPIO23 + 220Ω</TD></TR>
    </TABLE>
  >];

  raspi_adc [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#7c3aed">
      <TR><TD COLSPAN="2" BGCOLOR="#ede9fe"><B>MCP3204 / MCP3208</B></TD></TR>
      <TR><TD PORT="ch0">CH0</TD><TD>水位</TD></TR>
      <TR><TD PORT="ch1">CH1</TD><TD>CdS</TD></TR>
      <TR><TD>DIN</TD><TD>GPIO10 / 物理19</TD></TR>
      <TR><TD>DOUT</TD><TD>GPIO9 / 物理21</TD></TR>
      <TR><TD>CLK</TD><TD>GPIO11 / 物理23</TD></TR>
      <TR><TD>CS</TD><TD>GPIO8 / 物理24</TD></TR>
    </TABLE>
  >];

  raspberrypi2_sensors [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#ca8a04">
      <TR><TD COLSPAN="2" BGCOLOR="#fef9c3"><B>raspberrypi2 / 設置場所B</B></TD></TR>
      <TR><TD PORT="sda">BH1750 SDA</TD><TD>GPIO2 / 物理3</TD></TR>
      <TR><TD PORT="scl">BH1750 SCL</TD><TD>GPIO3 / 物理5</TD></TR>
      <TR><TD>BH1750 ADDR</TD><TD>GND / 0x23</TD></TR>
      <TR><TD PORT="ds">DS18B20 DATA</TD><TD>GPIO4 / 物理7 + 4.7kΩ</TD></TR>
      <TR><TD PORT="float">フロートSW</TD><TD>GPIO17 / 物理11 ↔ GND</TD></TR>
    </TABLE>
  >];

  common [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#475569" BGCOLOR="#f8fafc">
      <TR><TD><B>共通注意</B></TD></TR>
      <TR><TD ALIGN="LEFT">センサー電源は3.3V</TD></TR>
      <TR><TD ALIGN="LEFT">全機器のGNDを共通化</TD></TR>
      <TR><TD ALIGN="LEFT">GPIOへ5Vを入力しない</TD></TR>
    </TABLE>
  >];

  raspi_sensors:water:e -> raspi_adc:ch0:w [label="SIG"];
  raspi_sensors:cds:e -> raspi_adc:ch1:w [label="AO"];
  raspi_adc -> raspberrypi2_sensors [style=invis, weight=10];
  raspberrypi2_sensors -> common [style=invis, weight=10];
}
